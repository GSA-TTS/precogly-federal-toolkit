{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source", "response_defaults", "responses"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "type": "string" } },
    "response_defaults": { "$ref": "#/$defs/metadata" },
    "control_metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metadataOverride" }
    },
    "responses": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["part", "implementation"],
          "properties": {
            "part": { "type": ["string", "null"], "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "alternative-implementation",
            "planned",
            "customer-configured",
            "not-applicable",
            "not-implemented"
          ]
        },
        "origination": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inherited",
              "hybrid",
              "system-specific",
              "service-provider-corporate",
              "configured-by-customer",
              "provided-by-customer",
              "shared"
            ]
          }
        },
        "responsible_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["implementation_status", "origination"],
      "additionalProperties": false
    },
    "metadataOverride": {
      "type": "object",
      "properties": {
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "alternative-implementation",
            "planned",
            "customer-configured",
            "not-applicable",
            "not-implemented"
          ]
        },
        "origination": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inherited",
              "hybrid",
              "system-specific",
              "service-provider-corporate",
              "configured-by-customer",
              "provided-by-customer",
              "shared"
            ]
          }
        },
        "responsible_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
