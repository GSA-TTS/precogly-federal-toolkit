{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.precogly.dev/federal-toolkit/provider-workload.schema.json",
  "title": "Provider-scoped Example System workload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system",
    "lifecycle",
    "authorization_state",
    "feasibility_status",
    "model_role",
    "option_membership",
    "crm_target_asset",
    "topology"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "system": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["planned", "as-is", "as-built"] },
    "authorization_state": {
      "enum": ["proposal", "review-blocked", "approved", "current"]
    },
    "feasibility_status": { "enum": ["confirmed", "blocked", "pending"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "proposed_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "status",
          "mechanism",
          "source",
          "acceptance_criteria"
        ],
        "properties": {
          "control_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "recommended"] },
          "mechanism": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "pattern": "^managed-cloud-service-module:[a-z0-9-]+$"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        }
      }
    },
    "model_role": { "enum": ["core", "supplement"] },
    "option_membership": {
      "type": "array",
      "items": { "enum": ["option-1", "option-2"] },
      "maxItems": 1,
      "uniqueItems": true
    },
    "depends_on_system": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "crm_target_asset": { "type": "string", "minLength": 1 },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zones", "boundaries", "assets", "flows"],
      "properties": {
        "zones": { "type": "array", "items": { "$ref": "#/$defs/refObject" } },
        "boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary" }
        },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/refObject" } },
        "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "model_role": { "const": "supplement" } },
        "required": ["model_role"]
      },
      "then": {
        "required": ["depends_on_system"],
        "properties": {
          "option_membership": { "minItems": 1, "maxItems": 1 },
          "depends_on_system": { "const": "example-system-data-platform-core" }
        }
      },
      "else": {
        "properties": { "option_membership": { "maxItems": 0 } },
        "not": { "required": ["depends_on_system"] }
      }
    }
  ],
  "$defs": {
    "refObject": {
      "type": "object",
      "required": ["bom-ref", "name"],
      "properties": {
        "bom-ref": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "flow": {
      "allOf": [
        { "$ref": "#/$defs/refObject" },
        {
          "type": "object",
          "required": ["source", "destination"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "boundary": {
      "allOf": [
        { "$ref": "#/$defs/refObject" },
        {
          "type": "object",
          "required": ["type", "zones"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "zones": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    }
  }
}
