{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.precogly.dev/local/model-dfd.schema.json",
  "title": "Source DFD subset consumed by SSPP generation",
  "type": "object",
  "required": ["specFormat", "specVersion", "blueprints"],
  "properties": {
    "specFormat": { "const": "CycloneDX" },
    "specVersion": { "type": "string" },
    "metadata": { "type": "object" },
    "controls": { "type": "array" },
    "blueprints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["bom-ref", "assets", "flows"],
        "properties": {
          "bom-ref": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "modelTypes": { "type": "array", "items": { "type": "string" } },
          "properties": {
            "type": "array",
            "items": { "$ref": "#/$defs/property" }
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["bom-ref", "name"],
              "properties": {
                "bom-ref": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "properties": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/property" }
                }
              }
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bom-ref": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "zones": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": true
            }
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["bom-ref"],
              "properties": {
                "bom-ref": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "zone": { "type": "string" },
                "properties": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/property" }
                }
              }
            }
          },
          "dataStores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["bom-ref"],
              "properties": {
                "bom-ref": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "zone": { "type": "string" }
              }
            }
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["bom-ref", "source", "destination"],
              "properties": {
                "bom-ref": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "source": { "type": "string", "minLength": 1 },
                "destination": { "type": "string", "minLength": 1 },
                "properties": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/property" }
                }
              }
            }
          },
          "visualizations": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "property": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
