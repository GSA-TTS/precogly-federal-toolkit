{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public CCC inheritance starter profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "name",
    "baseline",
    "source_fedramp_baselines",
    "oscal_vault_commit",
    "fedramp_baselines_sha256",
    "source_ccc",
    "ccc_revision",
    "ccc_sha256",
    "purpose",
    "not_an_ssp",
    "not_an_authorization_assertion",
    "excluded_content",
    "fedramp_baseline_control_count",
    "ccc_designated_control_count",
    "baseline_controls_without_ccc_designation",
    "control_count",
    "controls"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "type": "string", "pattern": "^public-ccc-(low|moderate|high)-starter$" },
    "name": { "type": "string", "minLength": 1 },
    "baseline": { "enum": ["Low", "Moderate", "High"] },
    "source_fedramp_baselines": { "const": "vendor/oscal-vault/compliance/data/fedramp_baselines.json" },
    "oscal_vault_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "fedramp_baselines_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_ccc": { "const": "data/tiers/gsa-common-controls-rev7.yaml" },
    "ccc_revision": { "type": "string", "pattern": "^Rev 7( |$)" },
    "ccc_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "not_an_ssp": { "const": true },
    "not_an_authorization_assertion": { "const": true },
    "excluded_content": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fedramp_baseline_control_count": { "type": "integer", "minimum": 1 },
    "ccc_designated_control_count": { "type": "integer", "minimum": 1 },
    "baseline_controls_without_ccc_designation": { "type": "array", "items": { "$ref": "#/$defs/control_id" } },
    "control_count": { "type": "integer", "minimum": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "name", "federal_type", "contractor_type", "inheritance_source"],
        "properties": {
          "control_id": { "$ref": "#/$defs/control_id" },
          "name": { "type": "string", "minLength": 1 },
          "federal_type": { "type": "string", "minLength": 1 },
          "contractor_type": { "type": "string", "minLength": 1 },
          "inheritance_source": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "control_id": { "type": "string", "pattern": "^[A-Z]{2,3}-[0-9]+(?:\\([0-9]+\\))?$" }
  }
}
