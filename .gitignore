# Generated by the parent repository's `make oss-sync`, from
# data/oss-split-sources/gitignore. Edit it there, not here.

# --- Python ---
# `oss-sync` already excludes __pycache__ from the projection, but bytecode can
# still appear in this checkout when someone imports a script from inside it.
# Because `oss-sync` wipes the tree before regenerating, an untracked .pyc is
# never reported as a difference and can be committed by accident — so ignore it
# here as well.
__pycache__/
*.py[cod]
*$py.class

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
